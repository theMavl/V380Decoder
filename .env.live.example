# Скопируйте этот файл в .env.live и заполните параметры камеры.
V380_ID=
V380_USERNAME=admin
V380_PASSWORD=
V380_IP=
V380_PORT=8800

V380_SOURCE=lan
V380_OUTPUT=rtsp
V380_RTSP_PORT=8554
V380_HTTP_PORT=8080

V380_ENABLE_API=true
V380_ENABLE_ONVIF=true
V380_ENABLE_MJPEG=false
V380_SECURE=false
V380_DEBUG=false
V380_AUDIO_DUMP=
